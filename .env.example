# Copie para .env. Estas variáveis são lidas somente pelo backend Node.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_sua_chave
# Segredo operacional: somente servidor/worker. Nunca colocar em app.js.
SUPABASE_SECRET_KEY=
# Compatibilidade opcional: SUPABASE_SERVICE_ROLE_KEY (JWT legado), se não houver secret key.
# Gere um valor aleatório de pelo menos 32 bytes e mantenha-o estável entre reinicializações/réplicas.
ORIGIN_HMAC_SECRET=
# Endereço externo definitivo usado nos links dos setores.
PUBLIC_ORIGIN=http://127.0.0.1:5173
# URL autorizada no Supabase Auth para o futuro formulário de recuperação de senha.
AUTH_REDIRECT_URL=http://127.0.0.1:5173/?fluxo=recuperar-senha
ALLOW_SIGNUP=false
# IPs exatos dos proxies confiáveis; vazio ignora X-Forwarded-For.
TRUSTED_PROXY_IPS=
# Origens extras autorizadas, separadas por vírgula. Nunca usar *.
CORS_ORIGINS=
UPSTREAM_TIMEOUT_MS=8000
MAX_BODY_BYTES=32768
MAX_UPSTREAM_BYTES=8388608
MAX_EXPORT_ROWS=10000
PORT=5173
HOST=127.0.0.1
