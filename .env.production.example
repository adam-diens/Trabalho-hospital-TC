# Referência para Environment Variables do serviço WEB. Não contém segredos reais.
# O Render não recebe este arquivo automaticamente: render.yaml configura os serviços.
NODE_ENV=production
HOST=0.0.0.0
# PORT é fornecida pelo Render; não copiar a porta local para o painel.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_SUBSTITUIR
SUPABASE_SECRET_KEY=sb_secret_SUBSTITUIR
# O Blueprint gera este segredo uma vez. Não regenerar a cada deploy.
ORIGIN_HMAC_SECRET=SUBSTITUIR_POR_SEGREDO_ALEATORIO_DE_32_BYTES_OU_MAIS
ALLOW_SIGNUP=true
# No Render, OMITA PUBLIC_ORIGIN e AUTH_REDIRECT_URL: derivadas de RENDER_EXTERNAL_URL.
# Com domínio próprio, defina ambas usando o endereço HTTPS definitivo:
# PUBLIC_ORIGIN=https://pesquisa.seu-hospital.com.br
# AUTH_REDIRECT_URL=https://pesquisa.seu-hospital.com.br/?fluxo=recuperar-senha
# Um ingresso controlado do Render; validar a cadeia antes do uso em produção.
TRUST_PROXY_HOPS=1
TRUSTED_PROXY_IPS=
CORS_ORIGINS=
UPSTREAM_TIMEOUT_MS=8000
MAX_BODY_BYTES=32768
MAX_UPSTREAM_BYTES=8388608
MAX_EXPORT_ROWS=10000
# O WORKER recebe apenas NODE_ENV, SUPABASE_URL e SUPABASE_SECRET_KEY.
# Em outro provedor, configurar PUBLIC_ORIGIN e o proxy conforme a infraestrutura.
