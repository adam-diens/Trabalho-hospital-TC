{
  "name": "trabalho-hospital-tc",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  },
  "scripts": {
    "dev": "node backend/server.cjs",
    "start": "node backend/server.cjs",
    "test": "node --test tests/backend/*.test.cjs",
    "test:api": "node --test tests/backend/*.test.cjs",
    "test:frontend": "node tests/frontend/run.cjs",
    "test:db": "node tests/database/run.cjs",
    "db:bundle": "node scripts/build-database.cjs",
    "api:spec": "node scripts/build-api.cjs",
    "jobs:once": "node backend/worker.cjs",
    "jobs": "node backend/worker.cjs --watch",
    "check": "node scripts/check.cjs",
    "format": "prettier --write app.js \"assets/js/**/*.js\" \"backend/**/*.{cjs,js}\" \"scripts/**/*.cjs\" \"tests/**/*.cjs\" styles.css tablet.css index.html docs/api.html render.yaml package.json .prettierrc.json",
    "deploy:check": "node scripts/check-deploy.cjs"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  }
}
